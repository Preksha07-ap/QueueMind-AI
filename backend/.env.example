# ==============================================================================
# QueueMind AI - Environment Configuration Example
# Copy this file to .env and adjust variables for your local setup.
# Never commit actual credentials or secrets to version control.
# ==============================================================================

# Application Settings
PROJECT_NAME="QueueMind AI - Intelligent IT Helpdesk Management System"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000"

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=queuemind_user
DB_PASSWORD=your_secure_password_here
DB_NAME=queuemind_db

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-very-secure-random-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Future AI / Vector Engine Configuration (Planned for Phase 2+)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
QDRANT_HOST=localhost
QDRANT_PORT=6333
